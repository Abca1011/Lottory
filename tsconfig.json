{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vite/client"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "server/**/*.ts",
    "web/**/*.ts",
    "web/**/*.vue",
    "tests/**/*.ts"
  ]
}